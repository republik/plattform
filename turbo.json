{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": [".env.local", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.development.local",
        ".env.local",
        ".env.production",
        ".env.development",
        ".env"
      ]
    },
    // These backend modules compile TypeScript in place (.js next to .ts, see
    // each module's .gitignore), so their build output can't be described by
    // an `outputs` glob. Caching is disabled so a cache hit never skips them.
    // Modules that use `outDir: build` are covered by the `build/**` output above.
    "@orbiting/backend-modules-auth#build": {
      "cache": false
    },
    "@orbiting/backend-modules-base#build": {
      "cache": false
    },
    "@orbiting/backend-modules-call-to-actions#build": {
      "cache": false
    },
    "@orbiting/backend-modules-databroom#build": {
      "cache": false
    },
    "@orbiting/backend-modules-dataloader#build": {
      "cache": false
    },
    "@orbiting/backend-modules-discussions#build": {
      "cache": false
    },
    "@orbiting/backend-modules-invoices#build": {
      "cache": false
    },
    "@orbiting/backend-modules-publikator#build": {
      "cache": false
    },
    "@orbiting/backend-modules-republik#build": {
      "cache": false
    },
    "@orbiting/backend-modules-republik-crowdfundings#build": {
      "cache": false
    },
    "@orbiting/backend-modules-utils#build": {
      "cache": false
    },
    "@project-r/styleguide#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["SERVER"]
    },
    "lint": {
      "outputs": []
    },
    "start": {
      "persistent": true,
      "dependsOn": ["^build", "build"],
      "outputs": ["dist/**", ".next/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.development.local",
        ".env.local",
        ".env.production",
        ".env.development",
        ".env"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development.local",
        ".env.local",
        ".env.development",
        ".env"
      ]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test.local",
        ".env.local",
        ".env.test",
        ".env"
      ]
    },
    "@orbiting/backend-modules-test#test": {
      "cache": false
    },
    "prepare": {
      "outputs": ["dist/**", "build/**"]
    }
  }
}

# Commented envs are optional
# For further config options check the READMEs.

#############
# common
#############

PORT=5010

# Public URL (needs to be accessible from anywhere)
PUBLIC_URL=http://localhost:5010

# postgres url (shared between republik and publikator)
DATABASE_URL=postgres://postgres@localhost:5432/republik

# Sample data for postgres. Imported when using auto setup.
#DATABASE_SAMPLE_DATA_URL=https://domain.tld/sample-data.sql

# Set maximum allowed connections per server/worker instance
#DATABASE_MAX_CONNECTIONS=5

# While in development, when developing against a remote database, turn this on to allow connecting to it.
#PGSSLMODE=no-verify

# redis url, leave blank for default: 127.0.0.1:6379
#REDIS_URL=

# elasticsearch url, leave blank for default: localhost:9200
#ELASTIC_URL=

# url to republik-frontend
# used by
#  - auth to construct token links
#  - assets to proxy requests to the frontend
#  - documents to construct absolute document links
#  - republik for payment redirect urls
FRONTEND_BASE_URL=http://localhost:3010

# the urls of the frontends
CORS_ALLOWLIST_URL=http://localhost:3003,http://localhost:3005,http://localhost:3006,http://localhost:3010

# url to shop
# used by transactionals
SHOP_BASE_URL=http://localhost:3000

#url to crowdfunding-admin
# used by
#  - slack to send link to profiles to SLACK_CHANNEL_ADMIN
ADMIN_FRONTEND_BASE_URL=http://localhost:3003

# log requsts that take longer than the specified ms
#REQ_TIMEOUT=2000

# artificial delay processing requests
#REQ_DELAY_MS=2000

# Keep response connection alive by sending HTTP status code 102
# ("processing") every RES_KEEPALIVE_INTERVALS_SECS, repeating last
# interval until RES_KEEPALIVE_MAX_SECS reached. It then withdraws.
#
# If not set, keepalive middleware is not used
#RES_KEEPALIVE_INTERVALS_SECS=[25, 50]
# If not set, defaults to sum of intervals plus 5 seconds
#RES_KEEPALIVE_MAX_SECS=300

#############
# cluster
#############
# enable
#CLUSTER=true

# how many workers should be started
#WEB_CONCURRENCY=2

#############
# auth
#############

# express-session's secret
SESSION_SECRET=RANDOM

# cookie names
COOKIE_NAME=connect.sid

# activate basic auth on this API
# for assets: send basic auth to frontend (for /render and /frontend, leaks to phantomjscloud)
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=
# optional:
#BASIC_AUTH_REALM=

# enforce user to consent to policies when trying to authorize a session
# comma separated list of values
#ENFORCE_CONSENTS=PRIVACY

# NEVER DO THIS IN PROD
# signs in matching emails automatically
#AUTO_LOGIN_REGEX=^([a-zA-Z0-9._%+-]+)@test\.project-r\.construction$

#############
# mail
#############

# mails are plotted to stdout if set to false
SEND_MAILS=false

# Semi-colon separated regex patterns to allow emails send to.
# Use if you are well-versed with regular expressions.
# May conflict with SEND_MAILS_DOMAIN_FILTER
# Requires SEND_MAILS to be true
#SEND_MAILS_REGEX_FILTERS=^.+@republik\.ch$;^foobar@domain\.tld$

# If sending emails is enabled, catch-all emails generated and forward them to
# this email address instead.
#SEND_MAILS_CATCHALL=your.email@republik.ch

# Tags attached for internal query and stats purposes
# see https://mandrill.zendesk.com/hc/en-us/articles/205582467-How-to-Use-Tags-in-Mandrill
SEND_MAILS_TAGS=dev,localhost

# If Regular Expression is matched on a template name, nodemailer is used to sent email
#SEND_MAILS_NODEMAILER_TEMPLATE_REGEX=^signin*

# Connection URL to e.g. SMTP account nodemailer uses.
#SEND_MAILS_NODEMAILER_CONNECTION_URL='smtps://inbox@domain.tld:lengthy-password-with-dashes@asmtp.mail.hostpoint.ch/?pool=true'

# If Regular Expression is matched on a template name, mail is schedule instead of sent
#SEND_MAILS_SCHEDULE_TEMPLATE_REGEX=^[^signin].*

# If set, subject lines will be prefixed with "[Prefix]".
SEND_MAILS_SUBJECT_PREFIX=Test

# required for mails to work, set SEND_MAILS to false for a quick start
#MANDRILL_API_KEY=

# Allows to accept and verify Mandrill Webhook calls
#MANDRILL_WEBHOOK_URL=http://localhost:5010/mail/mandrill/webhook
#MANDRILL_WEBHOOK_KEY=xxx

# Shared secret for Sanity Studio's server-side Functions to call
# /webhooks/sanity/* (must match SANITY_STUDIO_API_TOKEN in the Studio env)
#SANITY_WEBHOOK_TOKEN=xxx

# Shared secret gating read-only GET /webhooks/sanity/* endpoints (e.g.
# subscriber-count). Distinct from SANITY_WEBHOOK_TOKEN because this one is
# shipped into studio's public browser bundle (must match
# SANITY_STUDIO_READ_TOKEN in the Studio env) — rotate independently if it
# leaks. Generic on purpose so future read-only endpoints can reuse it.
#SANITY_STUDIO_READ_TOKEN=xxx

# Sanity content API — read/write access, used by @orbiting/backend-modules-sanity
# to fetch/patch documents directly (e.g. audio generation results)
#SANITY_PROJECT_ID=
#SANITY_DATASET=
#SANITY_API_VERSION=2026-06-12
#SANITY_API_TOKEN=

# SANITY_SYNC (transition period, removable — see
# packages/backend-modules/sanity/lib/publikatorSync/index.ts). When "true",
# every publikator commit/publish/unpublish is mirrored into Sanity as a
# draft/published document in the background. Must be set the same way in
# both the web (enqueues) and scheduler (performs the sync) processes.
#SANITY_SYNC_FROM_PUBLIKATOR_ENABLED=false

# Pre-launch kill-switch for Sanity publish notifications (see
# packages/backend-modules/sanity/express/publishNotification.ts). While
# "false" (the default), a publish-notification webhook call from Studio is
# accepted and logged but nothing is enqueued -- no real emails/push go out.
# Set to "true" only once ready to send real notifications for Sanity
# articles. Must be set the same way in both the web (accepts the webhook)
# and scheduler (would perform the send) processes.
#SANITY_PUBLISH_NOTIFICATIONS_ENABLED=false

# Pre-launch kill-switch for Sanity-originated redirects (see
# packages/backend-modules/sanity/express/createRedirect.ts). While "false"
# (the default), a slug-change webhook call from Studio is accepted and
# logged but no redirect row is written -- a live path can't get redirected
# away before the agreed cutover. Set to "true" once ready to go live.
#SANITY_REDIRECTS_ENABLED=false

# Pre-launch kill-switch for Sanity discussions sync (see
# packages/backend-modules/sanity/express/discussions.ts). While "false"
# (the default), a discussion create/update webhook call from Studio is
# rejected with an explicit error (not faked success — Studio only calls
# this once per discussion and relies on the returned id, so pretending to
# succeed would leave the link permanently missing). Set to "true" once
# ready to go live.
#SANITY_DISCUSSIONS_ENABLED=false

# Pre-launch kill-switch for Sanity audio generation (see
# packages/backend-modules/sanity/express/generateAudio.ts). While "false"
# (the default), a sync-audio webhook call from Studio is accepted and
# logged but no (billed) Huebsch TTS job is started. Set to "true" once
# ready to go live.
#SANITY_AUDIO_GENERATION_ENABLED=false

# Pre-launch kill-switch for the SanityDocumentRef union member on
# Notification.object / Subscription.object (see
# packages/backend-modules/subscriptions/lib/genericObject.js). While
# "false" (the default), a subscription/notification pointing at
# already-migrated Sanity content resolves its object to null instead of a
# SanityDocumentRef -- the currently-deployed frontend has no fragment for
# that union member and can't render it. Set to "true" once the frontend can.
#SANITY_DOCUMENT_REFS_ENABLED=false

# Huebsch (text-to-speech vendor) integration, used by @orbiting/backend-modules-sanity's tts/ subfolder
#HUEBSCH_API_URL=
#HUEBSCH_API_KEY=
# HMAC key for signing/verifying the Huebsch callback URL
#HUEBSCH_WEBHOOK_SIGNING_SECRET=xxx
# Emit chapter marker nodes and store the returned chapters[] array
#ENABLE_CHAPTER_MARKERS=false
# Mirror generated audio into S3 (uses the shared AWS_* config below) as a
# backup copy alongside the Sanity file asset. Off by default, independent
# of AWS_* being configured for other features.
#ENABLE_TTS_S3_MIRROR=false

DEFAULT_MAIL_FROM_ADDRESS="kontakt@republik.ch"
DEFAULT_MAIL_FROM_NAME="Republik"

# mailchimp
# used by
#  - publikator to create campaigns and upload html
#  - republik to set interests based on belongings of a user
#MAILCHIMP_URL=https://us9.api.mailchimp.com
#MAILCHIMP_API_KEY=

